{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MFP",
  "version": "0.1.0",
  "identifier": "com.magene.mfp",
  "build": {
    "beforeDevCommand": "npm run build:bridge && npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MFP 本地工作台",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "resources": {
      "../dist-bridge/bridge-server.cjs": "dist-bridge/bridge-server.cjs",
      "../dist-bridge/fake-cli.mjs": "dist-bridge/fake-cli.mjs"
    }
  }
}
